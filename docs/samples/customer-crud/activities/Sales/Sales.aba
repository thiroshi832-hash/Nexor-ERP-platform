<?xml version="1.0" encoding="UTF-8"?>
<AtomicActivity version="1">
    <Meta>
        <Title>Sales</Title>
        <Id>Sales</Id>
        <Description>Customer maintenance UI.</Description>
        <Author>nexor docs</Author>
        <Created>2026-04-29T10:00:00</Created>
    </Meta>
    <Forms>
        <Form file="Customer_form.frm"/>
        <Form file="Customer_list.frm"/>
    </Forms>
    <Code><![CDATA[Sub Main()
    If Customer.Count() = 0 Then
        SeedDemoData()
    End If
    Print "Customer table has " & Customer.Count() & " row(s)."
End Sub

Sub SeedDemoData()
    Dim a = Customer.New()
    a.Name    = "Acme"
    a.Email   = "billing@acme.com"
    a.Balance = 1234.56
    a.Active  = True
    a.Save()
    Dim b = Customer.New()
    b.Name    = "Globex"
    b.Email   = "ar@globex.com"
    b.Balance = 42.0
    b.Active  = True
    b.Save()
End Sub

[Activity(RunsOn := Either)]
Function FormatBalance(amt) As String
    Return "$" & Round(amt, 2)
End Function
]]></Code>
</AtomicActivity>
