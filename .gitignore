# Build directories — top-level only so src/build/ (Nexor package builder)
# is not affected.
/build/
/bin/
**/build-*/
**/debug/
**/release/
nexor_studio/build/

# Qt user files
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
Makefile*
*.qm

# Qt object/intermediate
*.o
*.obj
*.so
*.dll
*.exe
*.lib
*.a
.qmake.cache
.qmake.stash
object_script.*

# IDE
.vs/
.vscode/
.idea/
*.swp
*~
*.bak

# OS
Thumbs.db
.DS_Store

# Nexor build outputs (compiled artifacts kept separate from source)
*.abx
*.frx

# Local user-only project files
*.local.pro

# Astro / Node (the docs site at website/ has its own .gitignore but
# keep these patterns here too in case anyone adds Node code elsewhere).
node_modules/
website/dist/
website/.astro/

# Per-project runtime artifacts under sample projects.
docs/samples/*/dist/
docs/samples/*/project.ndb
